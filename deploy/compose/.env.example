# Copy to .env and fill the required values before running deploy.sh.
# The compose file pulls every application image from the registry below; it
# does not build from source.

# Compose project and volume prefix. Change it to run this stack next to another
# RunCodes stack on the same host.
COMPOSE_PROJECT_NAME=runcodes

# --- Compose engine -------------------------------------------------------
# auto (default) uses Podman when available and falls back to Docker. Set it to
# "podman" or "docker" to force one engine. CONTAINER_ENGINE in the environment
# overrides this value.
CONTAINER_ENGINE=auto

# --- Images ---------------------------------------------------------------
# Application images are <registry>/<namespace>/runcodes-<service>:<tag>.
# Runner images are <registry>/<runner prefix>-<language>:<runner tag>.
RUNCODES_IMAGE_REGISTRY=ghcr.io
RUNCODES_IMAGE_NAMESPACE=runcodes-icmc
RUNCODES_IMAGE_TAG=latest
RUNCODES_RUNNER_IMAGE_PREFIX=runcodes-icmc/runcodes-runner
RUNCODES_RUNNER_IMAGE_TAG=latest
# Advanced: a full printf template for runner images, overriding the registry,
# prefix and runner tag above.
# JUDGE_IMAGE_FORMAT=ghcr.io/runcodes-icmc/runcodes-runner-%s:latest

# --- Host paths and runtime ----------------------------------------------
# The script turns a relative path into an absolute one before Compose starts.
RUNCODES_EXEC_DIR=./exec
# Rootless Podman socket for the judge. The judge always drives Podman, even
# when Compose runs on Docker. Leave empty to use
# /run/user/<uid>/podman/podman.sock.
PODMAN_SOCKET=
JUDGE_UID=0
JUDGE_GID=0

# --- Required secrets -----------------------------------------------------
RUNCODES_JWT_SECRET=
RUNCODES_DB_PASSWORD=
RUNCODES_DB_APP_PASSWORD=
RUNCODES_DB_JUDGE_PASSWORD=
RUNCODES_REDIS_PASSWORD=
RUNCODES_JUDGE_TOKEN=
RUNCODES_S3_CREDENTIALS_KEY=
RUNCODES_S3_CREDENTIALS_SECRET=

# --- Public origin and TLS ------------------------------------------------
# The hostname users type in the browser. Caddy obtains and renews its
# certificate, so DNS must already resolve here and inbound 80/443 must be
# open. Replace example.com before the first start.
RUNCODES_DOMAIN=runcodes.example.com
# The same origin with its scheme. Verification and password-reset links are
# built from it, so it must not stay localhost.
RUNCODES_PUBLIC_URL=https://runcodes.example.com
# Host ports. A public site publishes 80 and 443, but rootless Podman forwards
# them through rootlessport, which cannot bind below 1024 until the host allows
# it:
#   echo 'net.ipv4.ip_unprivileged_port_start=80' \
#     | sudo tee /etc/sysctl.d/99-rootless-ports.conf
#   sudo sysctl --system
# Without that, the frontend fails with "rootlessport cannot expose privileged
# port 80". A host proxy in front of the stack can keep 8080/8444 instead.
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# --- Mail -----------------------------------------------------------------
# The bundled smtp4dev catches mail on loopback. For a public deployment, set
# a real relay host and port here; smtp4dev then stays unused.
# The host is a bare hostname (no ssl://) and the relay must speak STARTTLS, so
# use port 587. Port 465 (implicit TLS) is not supported.
RUNCODES_SMTP_HOST=smtp4dev
RUNCODES_SMTP_PORT=25
RUNCODES_SMTP_FROM='RunCodes <no-reply@runcodes.local>'
RUNCODES_SMTP_USERNAME=
RUNCODES_SMTP_PASSWORD=

# --- Observability (optional) ---------------------------------------------
# Used by ./deploy.sh observability. Every telemetry UI and API binds to
# loopback; change the bind address only behind an authenticating proxy, because
# only Grafana has a login. Prometheus retention is capped by size, which is the
# real limit on a single host.
OBSERVABILITY_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=8GB

# --- Optional tuning ------------------------------------------------------
RUNCODES_JUDGE_STALE_TIMEOUT=35m
RUNCODES_JUDGE_MAX_QUEUE_DEPTH=100
JUDGE_CONCURRENCY=4
JUDGE_MAX_RUN_DURATION=30m
RUNCODES_DEADLINE_REMINDERS=true
RUNCODES_DEADLINE_REMINDER_INTERVAL=30m
SEAWEEDFS_VERSION=4.48
