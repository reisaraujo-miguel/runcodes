COMPOSE_PROJECT_NAME=runcodes-edge
TZ={{ runcodes_timezone }}
RUNCODES_VERSION={{ runcodes_version }}
IMAGE_REGISTRY={{ runcodes_image_registry }}
IMAGE_NAMESPACE={{ runcodes_image_namespace }}
IMAGE_TAG={{ runcodes_image_tag }}
PRIVATE_IP={{ private_ip }}
RUNCODES_DOMAIN={{ runcodes_domain }}
PUBLIC_URL={{ runcodes_public_url }}
JWT_SECRET={{ runcodes_jwt_secret }}
DEBUG_MODE={{ 'true' if runcodes_backend_debug_mode | bool else 'false' }}
LEGACY_PASSWORD_SALT="{{ runcodes_legacy_password_salt }}"
DB_APP_PASSWORD={{ runcodes_db_app_password }}
DATA_IP={{ hostvars[groups['data'][0]].private_ip }}
COMPUTE_IP={{ hostvars[groups['compute'][0]].private_ip }}
OBS_IP={{ hostvars[groups['observability'][0]].private_ip }}
JUDGE_TOKEN={{ runcodes_judge_token }}
JUDGE_STALE_TIMEOUT={{ runcodes_judge_stale_timeout }}
S3_ACCESS_KEY={{ runcodes_s3_access_key }}
S3_SECRET_KEY={{ runcodes_s3_secret_key }}
S3_REGION={{ runcodes_s3_region }}
S3_BUCKET_PREFIX={{ runcodes_s3_bucket_prefix }}
REDIS_PASSWORD={{ runcodes_redis_password }}
REDIS_DB={{ runcodes_redis_db }}
SMTP_HOST={{ runcodes_smtp_host }}
SMTP_PORT={{ runcodes_smtp_port }}
SMTP_FROM="{{ runcodes_smtp_from }}"
SMTP_USERNAME="{{ runcodes_smtp_username }}"
SMTP_PASSWORD="{{ runcodes_smtp_password }}"
DEPLOYMENT_ENVIRONMENT={{ runcodes_environment }}
OTEL_TRACES_SAMPLER={{ runcodes_otel_traces_sampler }}
OTEL_TRACES_SAMPLER_ARG="{{ runcodes_otel_traces_sampler_arg }}"
FRONTEND_MEM_LIMIT={{ rc_edge_frontend_mem_limit }}
BACKEND_MEM_LIMIT={{ rc_edge_backend_mem_limit }}
SMTP_MEM_LIMIT={{ rc_edge_smtp_mem_limit }}
ALLOY_MEM_LIMIT={{ rc_edge_alloy_mem_limit }}
NODE_EXPORTER_MEM_LIMIT={{ rc_edge_node_exporter_mem_limit }}
