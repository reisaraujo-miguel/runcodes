// Grafana Alloy on the compute host: scrape the judge's internal pprof listener
// and write CPU profiles to Pyroscope on the observability host.
//
// The judge's pprof port is never published; Alloy shares the compute compose
// network with it.

pyroscope.scrape "runcodes" {
  targets = [
    {
      "__address__" = "judge:6060",
      "service_name" = "runcodes-judge",
    },
  ]

  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [pyroscope.write.default.receiver]
}

pyroscope.write "default" {
  endpoint {
    url = "http://{{ hostvars[groups['observability'][0]].private_ip }}:4040"
  }

  external_labels = {
    "cluster"                = "{{ runcodes_cluster_name }}",
    "deployment_environment" = "{{ runcodes_environment }}",
    "node"                   = "{{ inventory_hostname }}",
  }
}
