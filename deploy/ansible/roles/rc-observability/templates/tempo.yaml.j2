# Tempo single-binary configuration for the four-machine deployment.
#
# Tempo 3.x monolithic mode: distributors, live-store, query frontend and
# compactor run in one process. The collector sends OTLP/gRPC to tempo:4317.
# The metrics-generator derives span metrics and service graphs and remote-writes
# them to Prometheus on the same host.
stream_over_http_enabled: true

server:
  http_listen_port: 3200
  log_level: info

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:4317
        http:
          endpoint: 0.0.0.0:4318

metrics_generator:
  registry:
    external_labels:
      source: tempo
      cluster: "{{ runcodes_cluster_name }}"
      environment: "{{ runcodes_environment }}"
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://prometheus:9090/api/v1/write
        send_exemplars: true

storage:
  trace:
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks

# Retention is a single knob here; the Compose default is 7 days. Raise it and
# size the observability disk accordingly.
backend_scheduler:
  provider:
    compaction:
      compaction:
        compaction_window: 1h
        block_retention: {{ runcodes_tempo_retention_hours }}h
        compacted_block_retention: 1h

overrides:
  defaults:
    metrics_generator:
      processors: ["span-metrics", "service-graphs"]

usage_report:
  reporting_enabled: false
