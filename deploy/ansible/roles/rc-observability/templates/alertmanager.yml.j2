# Alertmanager routing for the four-machine deployment.
#
# Production alerts go to the default receiver: the webhook URL stored in the
# secret file, plus Gmail email when runcodes_alertmanager_gmail_enabled is
# true. The bundled alert-sink is kept as a real, local receiver for the
# end-to-end smoke test: the upstream smoke test injects an alert named
# ObservabilitySmokeTest and asserts that it arrives there.
{% set gmail_enabled = runcodes_alertmanager_gmail_enabled | bool %}
global:
  resolve_timeout: 5m
{% if gmail_enabled %}
  # Gmail SMTP over STARTTLS. smtp_from must be the Gmail account (or a verified
  # alias) that authenticates; the app password is a mounted secret written by
  # Ansible from vault_alertmanager_gmail_app_password. The smarthost is
  # configurable for a Google Workspace SMTP relay.
  smtp_smarthost: '{{ runcodes_alertmanager_gmail_smarthost }}'
  smtp_from: '{{ runcodes_alertmanager_gmail_from }}'
  smtp_auth_username: '{{ runcodes_alertmanager_gmail_from }}'
  smtp_auth_password_file: /etc/alertmanager/secrets/gmail_app_password
  smtp_require_tls: true
{% endif %}

route:
  receiver: default
  group_by: [alertname, service_name, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

  routes:
    - matchers:
        - alertname="ObservabilitySmokeTest"
      receiver: alert-sink
      group_wait: 0s
      repeat_interval: 1h

    - matchers:
        - severity="critical"
      receiver: default
      group_wait: 0s
      repeat_interval: 1h

receivers:
  - name: default
    webhook_configs:
      # Written by Ansible from vault_alertmanager_webhook_url. When that is
      # empty the file points at alert-sink, so a fallback still delivers.
      - url_file: /etc/alertmanager/secrets/webhook_url
        send_resolved: true
        max_alerts: 0
{% if gmail_enabled %}
    # Gmail is an additional integration on this receiver: the webhook is still
    # notified and the same alert is also emailed.
    email_configs:
      # A comma-separated string; Ansible joins the recipient list.
      - to: '{{ runcodes_alertmanager_gmail_to | join(', ') }}'
        send_resolved: true
{% endif %}

  - name: alert-sink
    webhook_configs:
      - url: http://alert-sink:8080/alerts
        send_resolved: true
        max_alerts: 0

  - name: "null"

inhibit_rules:
  # A critical alert for a service silences its warnings with the same name.
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: [alertname, service_name]
