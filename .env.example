RUNCODES_JWT_SECRET='YourSuper-Dup3r$ecure-S3cret'
# Password of the database owner (`runcodes`). Only the database container and the
# migrations use it; the services log in as `runcodes_app` instead.
RUNCODES_DB_PASSWORD='YourSuperDuper-$3curePa$$'
# Password of `runcodes_app`, the role the backend and the judge log in as. It owns
# nothing and cannot change the schema (database/schema/05-app-role.sh).
RUNCODES_DB_APP_PASSWORD=''

RUNCODES_JUDGE_TOKEN=''

RUNCODES_S3_CREDENTIALS_KEY=''
RUNCODES_S3_CREDENTIALS_SECRET=''

# Account verification email. Compose sends through the bundled smtp4dev
# container, whose web UI is at http://localhost:8081 and whose SMTP port is
# published on 127.0.0.1:1025 for a backend run outside Compose.
# The origin used in verification links defaults to http://localhost:8080 (the
# Caddy frontend); set it for a public deployment:
# RUNCODES_PUBLIC_URL='https://runcodes.example'
# RUNCODES_SMTP_FROM='RunCodes <no-reply@runcodes.example>'
# A relay that requires authentication sets both:
# RUNCODES_SMTP_USERNAME=''
# RUNCODES_SMTP_PASSWORD=''
