# Required. Generate each with `openssl rand -hex 32` (or 24 for passwords);
# an empty value makes Compose refuse to start, which is intentional. Never
# reuse a placeholder: anyone with the repository can forge a session with a
# known JWT secret.
RUNCODES_JWT_SECRET=''
# Password of the database owner (`runcodes`). Only the database container and the
# migrations use it; the services log in as `runcodes_app` instead.
RUNCODES_DB_PASSWORD=''
# Password of `runcodes_app`, the role the backend and the judge log in as. It owns
# nothing and cannot change the schema (database/schema/05-app-role.sh).
RUNCODES_DB_APP_PASSWORD=''

RUNCODES_JUDGE_TOKEN=''

RUNCODES_S3_CREDENTIALS_KEY=''
RUNCODES_S3_CREDENTIALS_SECRET=''

# Account verification email. Compose sends through the bundled smtp4dev
# container, whose web UI is at http://localhost:8081 and whose SMTP port is
# published on 127.0.0.1:1025 for a backend run outside Compose.
# The origin used in verification links defaults to http://localhost:8080 (the
# Caddy frontend); set it for a public deployment:
# RUNCODES_PUBLIC_URL='https://runcodes.example'
# RUNCODES_SMTP_FROM='RunCodes <no-reply@runcodes.example>'
# A relay that requires authentication sets both:
# RUNCODES_SMTP_USERNAME=''
# RUNCODES_SMTP_PASSWORD=''

# --- Observability overlay (optional) -------------------------------------
# Start it with `make observability-up`; see docs-site/docs/observability/local.md.
# The overlay is opt-in and every port binds to 127.0.0.1 by default.
DEPLOYMENT_ENVIRONMENT=development
OBSERVABILITY_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
# The Grafana admin password and the Alertmanager webhook URL are generated into
# .observability/ (gitignored) by scripts/observability/init-secrets.sh. Do not
# commit them or put them here. Replace the webhook URL file with the real
# receiver URL from your secret manager for a shared environment.
#
# Optional: email alerts through Gmail. Copy
# observability/alertmanager/alertmanager.gmail.example.yml to
# .observability/alertmanager.yml, set smtp_from/smtp_auth_username and `to`,
# write the Google app password to
# .observability/alertmanager_gmail_app_password, then set:
# ALERTMANAGER_CONFIG_FILE=./.observability/alertmanager.yml
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SERVICE_VERSION=dev
# Browser tracing is built into the SPA. PUBLIC_OTEL_HTTP_URL must be an
# address the browser can reach (localhost works only on this host).
FRONTEND_OTEL_ENABLED=true
PUBLIC_OTEL_HTTP_URL=http://localhost:4318
VITE_OTEL_TRACES_SAMPLER_ARG=1.0
# Port overrides (defaults shown). Change these if the ports collide; update
# the URLs passed to the smoke test accordingly.
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318
# OTEL_HEALTH_PORT=13133
# OTEL_METRICS_PORT=8888
# OTEL_PROM_PORT=8889
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# ALERT_SINK_PORT=8085
# LOKI_PORT=3100
# TEMPO_PORT=3200
# GRAFANA_PORT=3000
# NODE_EXPORTER_PORT=9100
# POSTGRES_EXPORTER_PORT=9187
# REDIS_EXPORTER_PORT=9121
# BLACKBOX_EXPORTER_PORT=9115
# PYROSCOPE_PORT=4040
# ALLOY_PORT=12345
# PROMETHEUS_RETENTION_TIME=15d
# PROMETHEUS_RETENTION_SIZE=8GB
# PYROSCOPE_CONFIG_FILE=./observability/pyroscope/config.yaml
