# This is an example file for dev environments, modify it for production.
# Generate the JWT secret and database password with `openssl rand -hex 32`;
# a value committed here would let anyone with the repository forge a session.
RUNCODES_JWT_SECRET=''
RUNCODES_API_PORT=8443

RUNCODES_DB_HOST=127.0.0.1
RUNCODES_DB_PORT=5432
RUNCODES_DB_USER=runcodes
RUNCODES_DB_PASSWORD=''
RUNCODES_DB_NAME=runcodes
RUNCODES_DB_SSLMODE=disable

# Judge service (separate execution engine)
RUNCODES_JUDGE_URL=http://judge:9000
# Shared bearer token; must match JUDGE_AUTH_TOKEN. The judge refuses /v1
# requests when both are empty, unless JUDGE_ALLOW_INSECURE=true is set there.
RUNCODES_JUDGE_TOKEN=''
# How long a claimed commit may stay compiling/running before the sweeper
# marks it as server_error
RUNCODES_JUDGE_STALE_TIMEOUT=35m
# Refuse new submissions once the judge's queued backlog reaches this depth.
RUNCODES_JUDGE_MAX_QUEUE_DEPTH=100

# S3-compatible object storage (SeaweedFS)
RUNCODES_S3_ENDPOINT=http://seaweed:8333
RUNCODES_S3_REGION=sa-east-1
RUNCODES_S3_CREDENTIALS_KEY='YourS3AccessKey'
RUNCODES_S3_CREDENTIALS_SECRET='YourS3SecretKey'
# Buckets are named <prefix>-commits, <prefix>-cases, <prefix>-files,
# <prefix>-outputfiles
RUNCODES_S3_BUCKET_PREFIX=runcodes

# Redis cache (optional; the backend degrades to a no-op when unreachable)
RUNCODES_REDIS_ADDR=redis:6379
RUNCODES_REDIS_PASSWORD=''
RUNCODES_REDIS_DB=0

# Account verification email. The bundled smtp4dev container (started by
# `docker compose up smtp4dev`) accepts SMTP on 127.0.0.1:1025 and lists the
# captured messages at http://localhost:8081.
RUNCODES_SMTP_HOST=127.0.0.1
RUNCODES_SMTP_PORT=1025
RUNCODES_SMTP_FROM='RunCodes <no-reply@runcodes.local>'
# Leave the credentials empty for a local catcher; set both for a relay that
# requires authentication.
RUNCODES_SMTP_USERNAME=''
RUNCODES_SMTP_PASSWORD=''
# Browser-facing origin used in the verification link. This is the Vite dev
# server; with the Compose frontend use http://localhost:8080 instead.
RUNCODES_PUBLIC_URL=http://localhost:5173

# Deadline reminder email for students who did not submit an exercise closing
# in a week, and again when it closes in three days. The notifier runs in the
# API process; the interval is a Go duration and must be at least one minute.
RUNCODES_DEADLINE_REMINDERS=true
RUNCODES_DEADLINE_REMINDER_INTERVAL=30m

# --- OpenTelemetry (optional) ---------------------------------------------
# The backend/judge are instrumented but stay no-op unless an OTLP endpoint is
# configured. Compose sets these automatically in the observability overlay.
# When running the service directly, start the overlay (or a collector) and use:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=runcodes-backend
# DEPLOYMENT_ENVIRONMENT=development
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_METRIC_EXPORT_INTERVAL=10000

# Internal pprof listener for Alloy/Pyroscope (empty disables it). Do not
# publish this port: pprof exposes process internals. Compose uses :6060 on the
# internal network.
# PPROF_ADDR=:6060
