# --- HTTP API ---
JUDGE_ADDR=:9000
# Shared bearer token the backend sends. Leave empty to disable auth (dev only).
JUDGE_AUTH_TOKEN=

# --- Worker pool ---
# Number of containers the judge may run at once (IO-bound work).
JUDGE_CONCURRENCY=4
JUDGE_POLL_INTERVAL=1s
# How long finished runs stay replayable in memory for late SSE subscribers.
JUDGE_EVENT_RETENTION=10m

# --- Podman (rootless) ---
# Rootless socket, e.g. after `systemctl --user start podman.socket`.
JUDGE_PODMAN_URI=unix:///run/user/1000/podman/podman.sock

# --- Container execution ---
JUDGE_IMAGE_FORMAT=ghcr.io/runcodes-icmc/runcodes-runner-%s:latest
JUDGE_EXEC_DIR=/tmp/runcodes-judge
# Path to the same directory as seen by the podman service (needed when the
# judge itself runs in a container). Defaults to JUDGE_EXEC_DIR.
JUDGE_EXEC_DIR_REMOTE=
JUDGE_KEEP_WORKSPACES=false
# Per-language limits live in the images (monitor_max_ms is 1GB for Python, the
# JVM images set none, Go and C# compile with a 60s timeout). 0 sends nothing and
# leaves each image's own value in place; a value here overrides every language.
JUDGE_MONITOR_MAX_MEM_SIZE=0
JUDGE_MONITOR_MAX_FILE_SIZE=0
JUDGE_DEFAULT_COMPILATION_TIMEOUT=0

# How long the judge waits for the compilation milestones: its own patience, not
# the container's limit, so it must exceed the image's compilation timeout (60s at
# most) plus container startup.
JUDGE_COMPILATION_WAIT=2m
JUDGE_DEFAULT_EXEC_TIMEOUT=5
JUDGE_DEFAULT_CASE_TIMEOUT=3

# --- PostgreSQL (the durable queue) ---
RUNCODES_DB_HOST=localhost
RUNCODES_DB_PORT=5432
RUNCODES_DB_NAME=runcodes
# The application role, not the owner: it owns nothing and cannot change the
# schema (database/schema/05-app-role.sh). A database that only has the owner role
# needs `runcodes` here instead.
RUNCODES_DB_USER=runcodes_app
RUNCODES_DB_PASSWORD=

# --- S3 (SeaweedFS) ---
RUNCODES_S3_ENDPOINT=http://localhost:8333
RUNCODES_S3_REGION=sa-east-1
RUNCODES_S3_CREDENTIALS_KEY=test_key
RUNCODES_S3_CREDENTIALS_SECRET=test_secret
RUNCODES_S3_BUCKET_PREFIX=runcodes
