{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": ["dist"],
  "sortImports": {
    "partitionByNewline": true,
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "sortClassNames": true,
    "sortTailwindcssConfig": true,
    "functions": ["clsx", "cn", "tailwindMerge"]
  }
}
