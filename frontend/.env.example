# Only needed for local development (`bun run dev`), where the SPA runs on the
# Vite dev server and calls the backend directly. The Docker image serves the
# API same-origin through Caddy and leaves this unset (relative /api path).
IBM_TELEMETRY_DISABLED='true' # disable ibm telemetry

VITE_API_ENDPOINT=http://localhost:8443

# Fallbacks for the login page. The contact disclaimer and address are stored in
# the database (`platform_settings`) and edited by an admin in the admin panel;
# these values are only used until the API answers.
VITE_CONTACT_DISCLAIMER_HTML='Em caso de eventuais problemas com a plataforma, entre em contato com <a href="mailto:contact@example.com">contact@example.com</a>'
VITE_CONTACT_EMAIL='contact@example.com'

RUNCODES_DOMAIN=http://localhost
BACKEND_UPSTREAM=http://backend
