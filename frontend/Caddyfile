# Single entrypoint for the SPA and the API.
#
# The site address comes from RUNCODES_DOMAIN:
#   :80          -> local HTTP (default)
#   example.com  -> automatic HTTPS (Caddy obtains certificates on :443)
{$RUNCODES_DOMAIN::80} {
	route {
		# Browser hardening. The SPA needs inline styles and the theme bootstrap
		# script; everything else is served from this origin. connect-src includes
		# the local browser-telemetry collector used by the observability overlay.
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://localhost:4318; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		}

		# API and its long-lived SSE stream. The path is preserved
		# (/api/v1/...); buffering is disabled so submission events reach the
		# browser as they happen.
		@api path /api/*
		reverse_proxy @api {$BACKEND_UPSTREAM:http://backend:8443} {
			flush_interval -1
		}

		# Browser traces. The published frontend image is built with
		# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=/otel, so the SPA posts to this same
		# origin (no CORS) and the request lands here. Only the OTLP/HTTP traces
		# path is proxied, with a body cap, so the unauthenticated route cannot
		# be used as a large-payload proxy. Without a collector on the network
		# the route answers 502; the browser SDK drops the batch.
		handle /otel/v1/traces {
			request_body {
				max_size 4MB
			}
			uri strip_prefix /otel
			reverse_proxy {$OTEL_UPSTREAM:otel-collector:4318}
		}

		# Everything else is the single-page app.
		encode gzip
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
