# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Judge's shared execution directory (mounted at /exec). Keep the directory
# itself tracked via .gitkeep so a fresh checkout already has it: podman, unlike
# Docker, refuses to create a missing bind-mount source. Everything the judge
# writes inside is ignored.
/exec/*
!/exec/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

runcodes
main
dist/
.env
tmp/
bin/
